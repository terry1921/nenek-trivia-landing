{
  "name": "nenek-trivia-landing",
  "version": "1.0.0",
  "description": "Nenek Trivia landing page",
  "private": true,
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "start": "npm run clean:project && npm run build:dev && concurrently \"webpack serve --env dev\" \"bundle exec jekyll serve\"",
    "build:dev": "webpack --env dev",
    "build": "npm run clean:project && cross-env NODE_ENV=production webpack --env prod && cross-env JEKYLL_ENV=production bundle exec jekyll build",
    "build:optim": "npm run build",
    "build:pwa": "npm run clean:project && cross-env NODE_ENV=production webpack --env pwa && cross-env JEKYLL_ENV=pwa bundle exec jekyll build && node config/generate-service-worker.js",
    "build:pwa:optim": "npm run build:pwa",
    "serve:dist": "http-server _site",
    "clean:project": "rimraf ./_site ./assets ./_layouts/default.html"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.0.7",
    "css-loader": "^7.1.5",
    "cssnano": "^9.9.0",
    "favicons-webpack-plugin": "^6.0.1",
    "html-webpack-plugin": "^5.6.8",
    "http-server": "^14.1.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.32",
    "postcss-import": "^17.0.1",
    "postcss-loader": "^8.2.1",
    "rimraf": "^6.1.4",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1",
    "webpack-pwa-manifest": "^4.3.0",
    "workbox-build": "^7.4.1"
  },
  "dependencies": {
    "basiclightbox": "^5.0.4",
    "normalize.css": "^8.0.1"
  }
}
